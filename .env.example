# OpenWork Environment Configuration
# Copy this file to .env and fill in the values

# --- Secrets (REQUIRED - generate with: openssl rand -hex 32) ---
SECRET_KEY=<generate-with-openssl-rand-hex-32>
AES_SECRET_KEY=<generate-with-openssl-rand-hex-32>

# --- PostgreSQL ---
POSTGRES_USER=openwork
POSTGRES_PASSWORD=<set-a-strong-password>
POSTGRES_DB=openwork

# --- Admin bootstrap ---
ADMIN_PHONE=<your-phone-number>
ADMIN_PASSWORD=<set-a-strong-password>

# --- Optional ---
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=["http://localhost"]
# HOST_PORT=80
